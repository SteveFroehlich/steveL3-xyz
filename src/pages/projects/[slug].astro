---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects, isExternalProject } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects
    .filter((entry) => !isExternalProject(entry))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { id: entry.id },
    }));
}

const { id } = Astro.props;
const entry = await getEntry('projects', id);

if (!entry || entry.data.draft || isExternalProject(entry)) {
  return Astro.redirect('/projects');
}

const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/projects/${entry.id}`}
>
  <article class="project site-shell">
    <header class="project__header">
      <p class="meta">Projects{entry.data.status ? ` / ${entry.data.status}` : ''}</p>
      <h1 class="project__title">{entry.data.title}</h1>
      <p class="project__description">{entry.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    padding-block: var(--space-7) var(--space-9);
  }

  .project__header {
    max-width: var(--measure);
    margin-bottom: var(--space-7);
  }

  .project__title {
    margin: var(--space-4) 0;
    font-size: var(--text-3xl);
  }

  .project__description {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }
</style>
