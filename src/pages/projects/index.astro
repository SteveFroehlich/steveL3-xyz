---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPublishedProjects } from '../../lib/projects';

const projects = await getPublishedProjects();
---

<BaseLayout
  title="Projects"
  description="Selected projects and explorations from Steve Froehlich."
  canonicalPath="/projects"
>
  <section class="page site-shell">
    <header class="page__header">
      <p class="section__label">Projects</p>
      <h1 class="page__title">Projects</h1>
      <p class="page__lede">
        A curated view of projects currently being built or explored.
      </p>
    </header>

    {
      projects.length > 0 ? (
        <div>
          {projects.map((entry) => (
            <ProjectCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty">
          No projects published yet. Writing is the primary focus for now —
          <a href="/writing">browse writing</a>.
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-7) var(--space-9);
  }

  .page__header {
    margin-bottom: var(--space-6);
    max-width: 36rem;
  }

  .page__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-3xl);
  }

  .page__lede {
    margin: 0;
    color: var(--color-ink-muted);
  }

  .empty {
    color: var(--color-ink-muted);
    max-width: 32rem;
  }
</style>
