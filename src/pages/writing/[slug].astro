---
import { getEntry, render } from 'astro:content';
import WritingLayout from '../../layouts/WritingLayout.astro';
import { getPublishedWriting } from '../../lib/writing';

export async function getStaticPaths() {
  const writing = await getPublishedWriting();
  return writing.map((entry) => ({
    params: { slug: entry.id },
    props: { id: entry.id },
  }));
}

const { id } = Astro.props;
const entry = await getEntry('writing', id);

if (!entry || entry.data.draft) {
  return Astro.redirect('/writing');
}

const { Content } = await render(entry);
---

<WritingLayout entry={entry}>
  <Content />
</WritingLayout>
