---
import type { ProjectEntry } from '../lib/projects';
import { isExternalProject, projectHref } from '../lib/projects';

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const href = projectHref(entry);
const external = isExternalProject(entry);
---

<article class="project-card">
  <h3 class="project-card__title">
    <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
      {entry.data.title}
      {external && <span class="visually-hidden">(opens in new tab)</span>}
    </a>
  </h3>
  <p class="project-card__description">{entry.data.description}</p>
  {
    entry.data.status && (
      <p class="meta project-card__status">{entry.data.status}</p>
    )
  }
</article>

<style>
  .project-card {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }

  .project-card + .project-card {
    border-top: 1px solid var(--color-line);
  }

  .project-card__title {
    margin: 0;
    font-size: var(--text-lg);
  }

  .project-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .project-card__title a:hover {
    color: var(--color-accent);
  }

  .project-card__description {
    margin: 0;
    color: var(--color-ink-muted);
    max-width: 36rem;
  }

  .project-card__status {
    margin: 0;
  }
</style>
